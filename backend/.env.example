# ==============================================================================
# E-Waste Repurposing Platform & AI Vision System - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local or deployment environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Platform & Catalog Settings
# ------------------------------------------------------------------------------
# Enforce strict referential integrity and schema checks on startup.
# Options: true (fail fast if errors exist), false (log warnings only)
CATALOG_STRICT=true

# ------------------------------------------------------------------------------
# 2. AI Search & LLM Re-ranking (POST /api/v1/ai_search)
# ------------------------------------------------------------------------------
# Model name to use in local Ollama instance (e.g., qwen2.5:7b, llama3.2:3b).
# Ensure Ollama is running: `ollama run qwen2.5:7b`
AI_MODEL=qwen2.5:7b

# API Key for Tavily Live Web Search (free tier available at https://tavily.com).
# Required when calling the /api/v1/ai_search endpoint.
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ------------------------------------------------------------------------------
# 3. AI Vision Detection & MobileNetV3 Classifier (POST /detect)
# ------------------------------------------------------------------------------
# Minimum confidence required for a classification to be accepted (0.0 to 1.0).
# Below this threshold, /detect returns status "unknown".
AI_CONFIDENCE_THRESHOLD=0.55

# Margin between top-1 and top-2 probabilities. If (top1 - top2) < delta,
# the prediction is flagged as ambiguous and returns "unknown".
AI_AMBIGUITY_DELTA=0.10

# Input image square dimensions (in pixels) for model preprocessing.
AI_IMAGE_SIZE=224

# Execution hardware device for PyTorch inference:
# Leave blank for auto-detection (uses 'cuda' if GPU available, otherwise 'cpu').
# Explicit options: cpu, cuda
AI_DEVICE=

# Optional custom model checkpoint and artifact paths (defaults to models/mobilenetv3/):
# AI_MODEL_PATH=models/mobilenetv3/best_model.pth
# AI_CLASSES_PATH=models/mobilenetv3/classes.json
# AI_CONFIG_PATH=models/mobilenetv3/config.json
# AI_EVAL_REPORT_PATH=models/mobilenetv3/evaluation_report.json

# Optional custom dataset directory path:
# AI_DATASET_DIR=datasets/electronic_components/images
