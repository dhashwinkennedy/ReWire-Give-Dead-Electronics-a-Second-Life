{
  "architecture": "mobilenet_v3_small",
  "num_classes": 14,
  "image_size": 224,
  "normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "epochs": 10,
  "batch_size": 32,
  "learning_rate": 0.001,
  "freeze_epochs": 3,
  "use_class_weights": true,
  "device": "cpu",
  "seed": 42,
  "dataset_split": {
    "train": 0.7,
    "val": 0.15,
    "test": 0.15
  }
}