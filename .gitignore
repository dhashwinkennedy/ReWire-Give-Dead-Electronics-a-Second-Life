# ============================================================
# ReWire monorepo .gitignore  (backend/ + frontend/)
# ============================================================

# ------------------------------------------------------------
# Secrets & environment files (NEVER commit these)
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------
# Backend: Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
myenv/
venv/
.venv/
env/
ENV/

# Packaging / build artifacts
build/
dist-info/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, coverage & type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------
# Backend: runtime logs (keep the folder, ignore its contents)
# ------------------------------------------------------------
backend/logs/*
!backend/logs/.gitkeep
*.log

# ------------------------------------------------------------
# Backend: ML training artifacts & datasets
# ------------------------------------------------------------
# Raw / downloaded training data (large, reproducible via ai_detection/ingest.py)
backend/ai_detection/datasets/
backend/ai_detection/raw/
backend/datasets/
backend/dataset/

# Intermediate training checkpoints (keep only the final best_model.pth)
backend/models/**/checkpoint*.pth
backend/models/**/epoch_*.pth
runs/
wandb/
lightning_logs/
tensorboard/

# NOTE: backend/models/mobilenetv3/best_model.pth is intentionally NOT ignored
# so the app works after cloning. If it grows beyond 100 MB, track it with
# Git LFS instead:  git lfs track "backend/models/**/*.pth"

# ------------------------------------------------------------
# Frontend: Node / Vite
# ------------------------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# Package manager debug logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
*.tsbuildinfo

# ------------------------------------------------------------
# Editors & IDEs
# ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------
# Operating system files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
*.bak
*.tmp